  "spacing_and_layout": {
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
    "section_gap": "py-12 md:py-20",
    "grid_bento": "grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6",
    "product_grid": "grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6",
    "card_radius": "rounded-none md:rounded-sm",
    "button_radius": "rounded-sm"
  },
  "components": {
    "header": "Sticky header with backdrop-blur-xl, white background at 90% opacity, crisp border-b. Contains logo, search, wishlist icon, and cart icon.",
    "mega_menu": "Full-width dropdown with grid layout for categories (Men, Women, Combos, New Arrivals, Offers).",
    "hero_banner": "Full-bleed slider, aggressive typography overlay. Promo text 'BUY 2 GET 1 FREE' with 'Shop Now' CTA in accent pink #FF3F6C. Max height 80vh on mobile.",
    "product_card": "Minimalist layout. Image takes 80% of height. On hover: show second image + quick 'Add to Cart' button slides up. Price in bold, original price strikethrough. Discount badge top-left in accent pink.",
    "cart_drawer": "Slide-out drawer from right. Shows items, size selectors, subtotal, 'You saved X amount' in green, and large Checkout button.",
    "filters": "Sidebar on desktop, slide-up bottom sheet on mobile (size, price, category).",
    "buttons": "Primary: bg-[#FF3F6C] text-white hover:bg-black hover:text-white transition-colors duration-300. Secondary: bg-black text-white. Outline: border-2 border-black text-black hover:bg-black hover:text-white."
  },
  "motion_and_interactions": {
    "hover_state": "Product images scale up by 1.05x on hover (transition-transform duration-500 ease-out).",
    "button_hover": "-translate-y-0.5 shadow-lg",
    "page_transition": "Fade in on load"
  },
